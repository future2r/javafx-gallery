<?xml version="1.0" encoding="UTF-8"?>

<?import name.ulbricht.javafx.gallery.shell.DemoPage?>
<?import name.ulbricht.javafx.gallery.shell.Example?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<DemoPage xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
          fx:controller="name.ulbricht.javafx.gallery.pages.collections.ListViewController">

    <Example title="A simple ListView with selection"
             description="The selection model supports single and multiple selection (use CTRL or SHIFT to select several items).">
        <VBox spacing="12">
            <ListView fx:id="basicList" prefWidth="280" prefHeight="220" maxWidth="-Infinity"/>
            <Label fx:id="basicOutput" styleClass="example-output" text="Select an item." wrapText="true"/>
        </VBox>
        <options>
            <VBox spacing="10">
                <Label text="Selection mode" styleClass="options-title"/>
                <ComboBox fx:id="selectionMode" maxWidth="Infinity"/>
                <CheckBox fx:id="disableBasic" text="Disable ListView"/>
            </VBox>
        </options>
    </Example>

    <Example title="A ListView with a custom cell factory"
             description="A cell factory creates ListCells that render each item with an arbitrary graphic.">
        <VBox spacing="12">
            <ListView fx:id="personList" prefWidth="320" prefHeight="260" maxWidth="-Infinity"/>
            <Label fx:id="personOutput" styleClass="example-output" text="Select a person."/>
        </VBox>
        <options>
            <VBox spacing="10">
                <CheckBox fx:id="fixedCellSize" text="Fixed cell size (52 px)"/>
            </VBox>
        </options>
    </Example>

    <Example title="An editable ListView"
             description="With TextFieldListCell, double-click an item (or press F2) to edit it; ENTER commits, ESC cancels.">
        <VBox spacing="12">
            <ListView fx:id="editableList" editable="true" prefWidth="280" prefHeight="200" maxWidth="-Infinity"/>
            <HBox spacing="8">
                <Button text="Add item" onAction="#onAddItem"/>
                <Button fx:id="removeButton" text="Remove selected" onAction="#onRemoveItem"/>
            </HBox>
            <Label fx:id="editOutput" styleClass="example-output" text="Edit an item."/>
        </VBox>
        <options>
            <VBox spacing="10">
                <CheckBox fx:id="editableCheck" text="Editable" selected="true"/>
            </VBox>
        </options>
    </Example>

    <Example title="Horizontal orientation"
             description="A ListView can also lay out its cells horizontally.">
        <VBox spacing="12">
            <ListView fx:id="colorList" prefWidth="480" prefHeight="110" maxWidth="-Infinity" maxHeight="-Infinity"/>
            <Label fx:id="colorOutput" styleClass="example-output" text="Select a color."/>
        </VBox>
        <options>
            <VBox spacing="10">
                <Label text="Orientation" styleClass="options-title"/>
                <ComboBox fx:id="orientation" maxWidth="Infinity"/>
            </VBox>
        </options>
    </Example>
</DemoPage>
