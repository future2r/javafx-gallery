<?xml version="1.0" encoding="UTF-8"?>

<?import name.ulbricht.javafx.gallery.shell.DemoPage?>
<?import name.ulbricht.javafx.gallery.shell.Example?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<DemoPage xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
          fx:controller="name.ulbricht.javafx.gallery.pages.text.PasswordFieldController">

    <Example title="A simple PasswordField"
             description="The entered characters are masked. Copy and cut are disabled for PasswordFields.">
        <VBox spacing="12">
            <PasswordField fx:id="simpleField" promptText="Password" maxWidth="280" onAction="#onSimpleAction"/>
            <Label fx:id="simpleOutput" styleClass="example-output" text="Type a password and press ENTER."/>
        </VBox>
        <options>
            <VBox spacing="10">
                <CheckBox fx:id="disableField" text="Disable PasswordField"/>
            </VBox>
        </options>
    </Example>

    <Example title="Revealing the password"
             description="JavaFX has no built-in reveal button: a TextField sharing the text property is shown instead of the PasswordField.">
        <VBox spacing="12">
            <StackPane maxWidth="280" alignment="CENTER_LEFT">
                <PasswordField fx:id="revealPassword" promptText="Password" text="Secret123!"/>
                <TextField fx:id="revealPlain" promptText="Password"/>
            </StackPane>
            <CheckBox fx:id="showPassword" text="Show password"/>
        </VBox>
    </Example>

    <Example title="Password strength and confirmation"
             description="Listening to the text property allows live validation.">
        <VBox spacing="10" maxWidth="280">
            <PasswordField fx:id="newPassword" promptText="New password"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <ProgressBar fx:id="strengthBar" progress="0" prefWidth="160"/>
                <Label fx:id="strengthLabel" styleClass="example-output"/>
            </HBox>
            <PasswordField fx:id="confirmPassword" promptText="Confirm password"/>
            <Label fx:id="confirmOutput" styleClass="example-output"/>
        </VBox>
    </Example>
</DemoPage>
