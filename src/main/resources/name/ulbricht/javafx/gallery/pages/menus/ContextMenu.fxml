<?xml version="1.0" encoding="UTF-8"?>

<?import name.ulbricht.javafx.gallery.shell.DemoPage?>
<?import name.ulbricht.javafx.gallery.shell.Example?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.CheckMenuItem?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioMenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<DemoPage xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
          fx:controller="name.ulbricht.javafx.gallery.pages.menus.ContextMenuController">

    <Example title="A custom ContextMenu on a TextArea"
             description="Text input controls have a built-in context menu. Setting the contextMenu property replaces it with your own. Right-click into the text or press SHIFT+F10.">
        <VBox spacing="12">
            <TextArea fx:id="textArea" prefRowCount="5" wrapText="true"
                      text="Select some of this text and right-click it. The custom context menu offers clipboard commands and can convert the selection to upper or lower case.">
                <contextMenu>
                    <ContextMenu fx:id="textContextMenu">
                        <items>
                            <MenuItem fx:id="cutItem" text="Cu_t" onAction="#onCut"/>
                            <MenuItem fx:id="copyItem" text="_Copy" onAction="#onCopy"/>
                            <MenuItem text="_Paste" onAction="#onPaste"/>
                            <SeparatorMenuItem/>
                            <Menu fx:id="caseMenu" text="Change _case">
                                <items>
                                    <MenuItem text="_UPPER CASE" onAction="#onUpperCase"/>
                                    <MenuItem text="_lower case" onAction="#onLowerCase"/>
                                </items>
                            </Menu>
                            <SeparatorMenuItem/>
                            <MenuItem text="Select _all" onAction="#onSelectAll"/>
                        </items>
                    </ContextMenu>
                </contextMenu>
            </TextArea>
            <Label fx:id="textOutput" styleClass="example-output" text="Right-click the text."/>
        </VBox>
        <options>
            <VBox spacing="10">
                <CheckBox fx:id="useCustomMenu" text="Use custom context menu" selected="true"/>
            </VBox>
        </options>
    </Example>

    <Example title="A ContextMenu on any node"
             description="Every Control has a contextMenu property. For other nodes, show the menu from an onContextMenuRequested handler.">
        <VBox spacing="12">
            <Label fx:id="target" text="Right-click me" styleClass="demo-box" prefWidth="220" prefHeight="80"/>
            <Label fx:id="targetOutput" styleClass="example-output"/>
        </VBox>
        <options>
            <VBox spacing="10">
                <CheckBox fx:id="leftClickToo" text="Also open on left click"/>
            </VBox>
        </options>
    </Example>

    <Example title="Show a ContextMenu programmatically"
             description="show(anchor, side, dx, dy) positions the menu next to a node. The menu fires onShowing/onShown/onHiding/onHidden events.">
        <VBox spacing="12">
            <Button fx:id="showButton" text="Show menu" onAction="#onShowMenu"/>
            <Label fx:id="eventOutput" styleClass="example-output" text="Click the button."/>
        </VBox>
        <options>
            <VBox spacing="10">
                <Label text="Side" styleClass="options-title"/>
                <ComboBox fx:id="sideChoice" maxWidth="Infinity"/>
                <CheckBox fx:id="autoHide" text="Auto hide" selected="true"/>
            </VBox>
        </options>
    </Example>
</DemoPage>
