<?xml version="1.0" encoding="UTF-8"?>

<?import name.ulbricht.javafx.gallery.shell.DemoPage?>
<?import name.ulbricht.javafx.gallery.shell.Example?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<DemoPage xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
          fx:controller="name.ulbricht.javafx.gallery.pages.layout.SplitPaneController">

    <Example title="Two sides separated by a divider"
             description="Drag the divider to resize both sides. The divider position is a value between 0 and 1.">
        <SplitPane fx:id="split" prefWidth="480" prefHeight="220" maxWidth="-Infinity" maxHeight="-Infinity">
            <Label fx:id="firstSide" text="First" styleClass="demo-box" minWidth="40" minHeight="30"
                   maxWidth="Infinity" maxHeight="Infinity"/>
            <Label text="Second" styleClass="demo-box,alt-1" minWidth="40" minHeight="30"
                   maxWidth="Infinity" maxHeight="Infinity"/>
        </SplitPane>
        <options>
            <VBox spacing="10">
                <Label text="Orientation" styleClass="options-title"/>
                <ComboBox fx:id="orientation" maxWidth="Infinity"/>
                <Label fx:id="positionLabel" styleClass="options-title"/>
                <Slider fx:id="position" min="0" max="1" value="0.5"/>
                <CheckBox fx:id="resizableWithParent" text="First side resizes with parent" selected="true"/>
            </VBox>
        </options>
    </Example>

    <Example title="Nested split panes"
             description="Split panes can be nested to build IDE-like layouts with several dividers.">
        <VBox spacing="12">
            <SplitPane fx:id="outerSplit" dividerPositions="0.25,0.75" prefWidth="560" prefHeight="260"
                       maxWidth="-Infinity" maxHeight="-Infinity">
                <Label text="Explorer" styleClass="demo-box" minWidth="40" maxWidth="Infinity" maxHeight="Infinity"/>
                <SplitPane fx:id="innerSplit" orientation="VERTICAL" dividerPositions="0.7">
                    <Label text="Editor" styleClass="demo-box,alt-2" minHeight="30" maxWidth="Infinity"
                           maxHeight="Infinity"/>
                    <Label text="Console" styleClass="demo-box,alt-3" minHeight="30" maxWidth="Infinity"
                           maxHeight="Infinity"/>
                </SplitPane>
                <Label text="Outline" styleClass="demo-box,alt-1" minWidth="40" maxWidth="Infinity" maxHeight="Infinity"/>
            </SplitPane>
            <Label fx:id="nestedOutput" styleClass="example-output"/>
        </VBox>
        <options>
            <VBox spacing="10">
                <Button text="Reset dividers" maxWidth="Infinity" onAction="#onResetDividers"/>
                <HBox spacing="8">
                    <Button text="Add pane" onAction="#onAddPane"/>
                    <Button text="Remove pane" onAction="#onRemovePane"/>
                </HBox>
            </VBox>
        </options>
    </Example>
</DemoPage>
