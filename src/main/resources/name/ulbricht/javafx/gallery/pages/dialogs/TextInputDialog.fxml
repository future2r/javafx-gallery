<?xml version="1.0" encoding="UTF-8"?>

<?import name.ulbricht.javafx.gallery.shell.DemoPage?>
<?import name.ulbricht.javafx.gallery.shell.Example?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<DemoPage xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
          fx:controller="name.ulbricht.javafx.gallery.pages.dialogs.TextInputDialogController">

    <Example title="Ask for a line of text"
             description="showAndWait() returns an Optional that is empty when the dialog was cancelled.">
        <VBox spacing="12">
            <Button text="Enter your name…" onAction="#onAskName"/>
            <Label fx:id="nameOutput" styleClass="example-output" text="Hello, stranger."/>
        </VBox>
        <options>
            <VBox spacing="10">
                <Label text="Default value" styleClass="options-title"/>
                <TextField fx:id="defaultValue" text="Jane Doe"/>
                <Label text="Header text" styleClass="options-title"/>
                <TextField fx:id="headerText" text="What's your name?"/>
                <Label text="Prompt text" styleClass="options-title"/>
                <TextField fx:id="promptText" text="First and last name"/>
            </VBox>
        </options>
    </Example>

    <Example title="Validating the input"
             description="getEditor() exposes the TextField. Binding the OK button's disable property to a validation rule prevents invalid results.">
        <VBox spacing="12">
            <Button text="Set the age…" onAction="#onAskAge"/>
            <Label fx:id="ageOutput" styleClass="example-output" text="No age set yet."/>
        </VBox>
    </Example>
</DemoPage>
