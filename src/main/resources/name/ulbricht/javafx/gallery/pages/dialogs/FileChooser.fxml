<?xml version="1.0" encoding="UTF-8"?>

<?import name.ulbricht.javafx.gallery.shell.DemoPage?>
<?import name.ulbricht.javafx.gallery.shell.Example?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<DemoPage xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
          fx:controller="name.ulbricht.javafx.gallery.pages.dialogs.FileChooserController">

    <Example title="Open a file"
             description="showOpenDialog() returns the chosen file or null. Extension filters restrict the files shown; showOpenMultipleDialog() allows several files.">
        <VBox spacing="12">
            <Button text="Open file…" onAction="#onOpen"/>
            <Label fx:id="openOutput" styleClass="example-output" text="No file chosen." wrapText="true"/>
        </VBox>
        <options>
            <VBox spacing="10">
                <CheckBox fx:id="multiple" text="Allow multiple files"/>
                <CheckBox fx:id="useFilters" text="Use extension filters" selected="true"/>
            </VBox>
        </options>
    </Example>

    <Example title="Save a file"
             description="showSaveDialog() asks for a file name. The selected extension filter tells which file type the user picked. (This demo does not write anything.)">
        <VBox spacing="12">
            <Button text="Save as…" onAction="#onSave"/>
            <Label fx:id="saveOutput" styleClass="example-output" text="Nothing saved yet." wrapText="true"/>
        </VBox>
        <options>
            <VBox spacing="10">
                <Label text="Initial file name" styleClass="options-title"/>
                <TextField fx:id="initialFileName" text="Untitled.txt"/>
            </VBox>
        </options>
    </Example>

    <Example title="Pick a folder with DirectoryChooser"
             description="DirectoryChooser shows the native folder picker. The initial directory is remembered between calls.">
        <VBox spacing="12">
            <Button text="Choose folder…" onAction="#onChooseDirectory"/>
            <Label fx:id="directoryOutput" styleClass="example-output" text="No folder chosen." wrapText="true"/>
        </VBox>
    </Example>
</DemoPage>
