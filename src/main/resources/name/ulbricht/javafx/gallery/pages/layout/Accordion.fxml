<?xml version="1.0" encoding="UTF-8"?>

<?import name.ulbricht.javafx.gallery.shell.DemoPage?>
<?import name.ulbricht.javafx.gallery.shell.Example?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.VBox?>

<DemoPage xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
          fx:controller="name.ulbricht.javafx.gallery.pages.layout.AccordionController">

    <Example title="An Accordion with three panes"
             description="Only one TitledPane of an Accordion can be expanded at a time; expanding one collapses the others. The expanded pane is available via expandedPane.">
        <VBox spacing="12">
            <Accordion fx:id="accordion" prefWidth="360" maxWidth="-Infinity">
                <panes>
                    <TitledPane fx:id="generalPane" text="General" expanded="false">
                        <VBox spacing="8">
                            <CheckBox text="Open last project on startup" selected="true"/>
                            <CheckBox text="Confirm before exiting"/>
                        </VBox>
                    </TitledPane>
                    <TitledPane text="Appearance" expanded="false">
                        <VBox spacing="8">
                            <CheckBox text="Use dark mode"/>
                            <CheckBox text="Show line numbers" selected="true"/>
                            <CheckBox text="Show whitespace"/>
                        </VBox>
                    </TitledPane>
                    <TitledPane text="Notifications" expanded="false">
                        <VBox spacing="8">
                            <CheckBox text="Play a sound" selected="true"/>
                            <CheckBox text="Show a badge on the task bar icon" selected="true"/>
                        </VBox>
                    </TitledPane>
                </panes>
            </Accordion>
            <Label fx:id="accordionOutput" styleClass="example-output"/>
        </VBox>
        <options>
            <VBox spacing="10">
                <CheckBox fx:id="animated" text="Animated" selected="true"/>
                <Button text="Expand next pane" maxWidth="Infinity" onAction="#onExpandNext"/>
                <Button text="Collapse all" maxWidth="Infinity" onAction="#onCollapseAll"/>
            </VBox>
        </options>
    </Example>

    <Example title="An Accordion as navigation sidebar"
             description="Each pane holds a list; the Accordion is given a fixed height so the expanded pane fills the remaining space.">
        <VBox spacing="12">
            <Accordion fx:id="sidebar" prefWidth="260" prefHeight="300" maxWidth="-Infinity" maxHeight="-Infinity">
                <panes>
                    <TitledPane fx:id="mailPane" text="Mail" expanded="false">
                        <ListView fx:id="mailList"/>
                    </TitledPane>
                    <TitledPane text="Calendar" expanded="false">
                        <ListView fx:id="calendarList"/>
                    </TitledPane>
                    <TitledPane text="Contacts" expanded="false">
                        <ListView fx:id="contactsList"/>
                    </TitledPane>
                </panes>
            </Accordion>
            <Label fx:id="sidebarOutput" styleClass="example-output" text="Select an entry."/>
        </VBox>
    </Example>
</DemoPage>
