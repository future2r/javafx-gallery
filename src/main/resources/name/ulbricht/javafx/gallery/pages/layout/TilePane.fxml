<?xml version="1.0" encoding="UTF-8"?>

<?import name.ulbricht.javafx.gallery.shell.DemoPage?>
<?import name.ulbricht.javafx.gallery.shell.Example?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<DemoPage xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
          fx:controller="name.ulbricht.javafx.gallery.pages.layout.TilePaneController">

    <Example title="Uniformly sized tiles"
             description="All tiles have the same size – by default the size of the largest child. Children are aligned within their tile by tileAlignment.">
        <TilePane fx:id="tiles" styleClass="demo-area" hgap="8" vgap="8" prefWidth="480" prefHeight="240"
                  maxWidth="-Infinity" maxHeight="-Infinity"/>
        <options>
            <VBox spacing="10">
                <Label text="Orientation" styleClass="options-title"/>
                <ComboBox fx:id="orientation" maxWidth="Infinity"/>
                <Label text="Tile alignment" styleClass="options-title"/>
                <ComboBox fx:id="tileAlignment" maxWidth="Infinity"/>
                <Label fx:id="gapLabel" styleClass="options-title"/>
                <Slider fx:id="gap" min="0" max="24" value="8"/>
                <CheckBox fx:id="fixedTileSize" text="Fixed tile size"/>
                <Slider fx:id="tileSize" min="40" max="140" value="90"/>
                <HBox spacing="8">
                    <Button text="Add" onAction="#onAddTile"/>
                    <Button text="Remove" onAction="#onRemoveTile"/>
                </HBox>
            </VBox>
        </options>
    </Example>

    <Example title="Preferred number of columns"
             description="prefColumns determines the preferred width of a horizontal TilePane – it only has an effect if the pane is sized to its preferred width.">
        <TilePane fx:id="columnTiles" styleClass="demo-area" hgap="6" vgap="6" prefTileWidth="64" prefTileHeight="48"
                  maxWidth="-Infinity" maxHeight="-Infinity"/>
        <options>
            <VBox spacing="10">
                <Label text="Preferred columns" styleClass="options-title"/>
                <Spinner fx:id="prefColumns" maxWidth="Infinity"/>
            </VBox>
        </options>
    </Example>
</DemoPage>
