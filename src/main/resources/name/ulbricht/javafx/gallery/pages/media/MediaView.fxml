<?xml version="1.0" encoding="UTF-8"?>

<?import name.ulbricht.javafx.gallery.shell.DemoPage?>
<?import name.ulbricht.javafx.gallery.shell.Example?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.media.MediaView?>

<DemoPage xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
          fx:controller="name.ulbricht.javafx.gallery.pages.media.MediaViewController">

    <Example title="Play a video"
             description="A MediaView displays the video of a MediaPlayer, which in turn plays a Media. The player is prepared when the page opens and disposed when you leave the page.">
        <VBox spacing="10" maxWidth="480">
            <StackPane minHeight="270" prefWidth="480" prefHeight="270" styleClass="demo-area">
                <MediaView fx:id="mediaView" fitWidth="480" preserveRatio="true"/>
                <Label fx:id="placeholder" text="Loading the video…" styleClass="example-output"/>
            </StackPane>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="playButton" text="Play" minWidth="70" onAction="#onPlayPause"/>
                <Button fx:id="stopButton" text="Stop" onAction="#onStop"/>
                <Slider fx:id="seekSlider" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Label fx:id="timeLabel" text="0:00 / 0:00" minWidth="90"/>
            </HBox>
            <Label fx:id="mediaOutput" styleClass="example-output" wrapText="true"/>
        </VBox>
        <options>
            <VBox spacing="10">
                <Label fx:id="volumeLabel" styleClass="options-title"/>
                <Slider fx:id="volumeSlider" min="0" max="1" value="0.5"/>
                <ToggleButton fx:id="muteToggle" text="Mute"/>
                <Label fx:id="rateLabel" styleClass="options-title"/>
                <Slider fx:id="rateSlider" min="0.25" max="2" value="1" majorTickUnit="0.25" snapToTicks="true"/>
                <CheckBox fx:id="loopCheck" text="Loop"/>
                <CheckBox fx:id="preserveRatioCheck" text="Preserve ratio" selected="true"/>
            </VBox>
        </options>
    </Example>

    <Example title="Player status and media information"
             description="MediaPlayer exposes its status, buffer progress and the media's metadata as observable properties.">
        <VBox spacing="6">
            <Label fx:id="statusLabel" text="Status: (no player yet)"/>
            <Label fx:id="durationLabel" text="Duration: –"/>
            <Label fx:id="sizeLabel" text="Video size: –"/>
            <Label fx:id="bufferLabel" text="Buffered: –"/>
            <Label fx:id="cycleLabel" text="Finished cycles: 0"/>
        </VBox>
    </Example>
</DemoPage>
