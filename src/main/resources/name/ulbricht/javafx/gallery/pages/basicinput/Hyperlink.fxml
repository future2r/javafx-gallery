<?xml version="1.0" encoding="UTF-8"?>

<?import name.ulbricht.javafx.gallery.shell.DemoPage?>
<?import name.ulbricht.javafx.gallery.shell.Example?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<DemoPage xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
          fx:controller="name.ulbricht.javafx.gallery.pages.basicinput.HyperlinkController">

    <Example title="A Hyperlink that tracks its visited state"
             description="After the first click the Hyperlink is marked as visited and rendered in a different color.">
        <VBox spacing="12">
            <Hyperlink fx:id="simpleLink" text="openjfx.io" onAction="#onSimpleLink"/>
            <Label fx:id="simpleOutput" styleClass="example-output" text="Click the link."/>
        </VBox>
        <options>
            <VBox spacing="10">
                <CheckBox fx:id="disableLink" text="Disable Hyperlink"/>
                <Button text="Reset visited state" onAction="#onResetVisited"/>
            </VBox>
        </options>
    </Example>

    <Example title="A Hyperlink with a graphic">
        <VBox spacing="12">
            <Hyperlink fx:id="graphicLink" text="JavaFX documentation" onAction="#onGraphicLink"/>
            <Label fx:id="graphicOutput" styleClass="example-output"/>
        </VBox>
    </Example>

    <Example title="Hyperlinks inline in a TextFlow"
             description="Hyperlinks can be mixed with Text nodes in a TextFlow to build running text with links.">
        <VBox spacing="12">
            <TextFlow fx:id="textFlow" maxWidth="460">
                <Text styleClass="flow-text" text="JavaFX is an open source, next generation client application platform. Read the "/>
                <Hyperlink text="getting started guide" onAction="#onInlineLink"/>
                <Text styleClass="flow-text" text=" or browse the "/>
                <Hyperlink text="API documentation" onAction="#onInlineLink"/>
                <Text styleClass="flow-text" text=" to learn more."/>
            </TextFlow>
            <Label fx:id="inlineOutput" styleClass="example-output"/>
        </VBox>
    </Example>
</DemoPage>
