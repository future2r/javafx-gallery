<?xml version="1.0" encoding="UTF-8"?>

<?import name.ulbricht.javafx.gallery.shell.DemoPage?>
<?import name.ulbricht.javafx.gallery.shell.Example?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<DemoPage xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
          fx:controller="name.ulbricht.javafx.gallery.pages.layout.StackPaneController">

    <Example title="Children stacked on top of each other"
             description="The first child is at the back, the last child at the front. All children are positioned according to the alignment of the pane, unless a child has its own StackPane.alignment.">
        <VBox spacing="12">
            <StackPane fx:id="stack" styleClass="demo-area" prefWidth="420" prefHeight="240" maxWidth="-Infinity"
                       maxHeight="-Infinity">
                <Label text="Back" styleClass="demo-box" prefWidth="260" prefHeight="180" style="-fx-alignment: top-left;"
                       onMouseClicked="#onBoxClicked"/>
                <Label text="Middle" styleClass="demo-box,alt-1" prefWidth="180" prefHeight="120" style="-fx-alignment: top-left;"
                       onMouseClicked="#onBoxClicked"/>
                <Label text="Front" styleClass="demo-box,alt-2" prefWidth="100" prefHeight="60"
                       onMouseClicked="#onBoxClicked"/>
            </StackPane>
            <Label fx:id="stackOutput" styleClass="example-output" text="Click a box to bring it to the front."/>
        </VBox>
        <options>
            <VBox spacing="10">
                <Label text="Alignment" styleClass="options-title"/>
                <ComboBox fx:id="alignment" maxWidth="Infinity"/>
                <Button text="Send front box to back" maxWidth="Infinity" onAction="#onSendToBack"/>
            </VBox>
        </options>
    </Example>

    <Example title="Overlays and badges"
             description="StackPane is the natural choice for overlays: a badge aligned to a corner with StackPane.alignment and margin, or a busy overlay covering the whole content.">
        <StackPane fx:id="overlayHost" prefWidth="320" prefHeight="200" maxWidth="-Infinity" maxHeight="-Infinity">
            <Rectangle fx:id="picture" width="320" height="200" arcWidth="12" arcHeight="12"/>
            <Label fx:id="badge" text="NEW" styleClass="demo-box,alt-1" StackPane.alignment="TOP_RIGHT"/>
            <Label text="Photo caption" styleClass="demo-box,alt-3" StackPane.alignment="BOTTOM_LEFT"/>
            <StackPane fx:id="busyOverlay" visible="false" style="-fx-background-color: rgba(0, 0, 0, 0.45); -fx-background-radius: 6;">
                <ProgressIndicator maxWidth="48" maxHeight="48"/>
            </StackPane>
        </StackPane>
        <options>
            <VBox spacing="10">
                <CheckBox fx:id="showBadge" text="Show badge" selected="true"/>
                <CheckBox fx:id="showBusy" text="Show busy overlay"/>
                <Label text="Badge alignment" styleClass="options-title"/>
                <ComboBox fx:id="badgeAlignment" maxWidth="Infinity"/>
            </VBox>
        </options>
    </Example>
</DemoPage>
