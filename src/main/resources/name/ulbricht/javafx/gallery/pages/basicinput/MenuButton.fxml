<?xml version="1.0" encoding="UTF-8"?>

<?import name.ulbricht.javafx.gallery.shell.DemoPage?>
<?import name.ulbricht.javafx.gallery.shell.Example?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.CheckMenuItem?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioMenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<DemoPage xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
          fx:controller="name.ulbricht.javafx.gallery.pages.basicinput.MenuButtonController">

    <Example title="A simple MenuButton">
        <VBox spacing="12">
            <MenuButton fx:id="simpleMenuButton" text="Email">
                <items>
                    <MenuItem text="Send" onAction="#onSimpleItem"/>
                    <MenuItem text="Reply" onAction="#onSimpleItem"/>
                    <MenuItem text="Reply all" onAction="#onSimpleItem"/>
                    <MenuItem text="Forward" onAction="#onSimpleItem"/>
                </items>
            </MenuButton>
            <Label fx:id="simpleOutput" styleClass="example-output" text="Open the menu and pick a command."/>
        </VBox>
        <options>
            <VBox spacing="10">
                <CheckBox fx:id="disableMenuButton" text="Disable MenuButton"/>
                <Label text="Popup side" styleClass="options-title"/>
                <ComboBox fx:id="popupSide" maxWidth="Infinity"/>
            </VBox>
        </options>
    </Example>

    <Example title="A MenuButton with check items, radio items and a submenu"
             description="Any MenuItem subtype can be used: CheckMenuItem, RadioMenuItem, SeparatorMenuItem and nested Menus.">
        <VBox spacing="12">
            <MenuButton fx:id="viewMenuButton" text="View">
                <items>
                    <CheckMenuItem fx:id="showStatusBar" text="Status bar" selected="true"/>
                    <CheckMenuItem fx:id="showSidebar" text="Sidebar"/>
                    <SeparatorMenuItem/>
                    <RadioMenuItem fx:id="sortByName" text="Sort by name" selected="true"/>
                    <RadioMenuItem fx:id="sortByDate" text="Sort by date"/>
                    <RadioMenuItem fx:id="sortBySize" text="Sort by size"/>
                    <SeparatorMenuItem/>
                    <Menu text="Zoom">
                        <items>
                            <MenuItem text="50 %" onAction="#onZoom"/>
                            <MenuItem text="100 %" onAction="#onZoom"/>
                            <MenuItem text="200 %" onAction="#onZoom"/>
                        </items>
                    </Menu>
                </items>
            </MenuButton>
            <Label fx:id="viewOutput" styleClass="example-output"/>
        </VBox>
    </Example>

    <Example title="Building the menu at runtime"
             description="The items list is an ObservableList and can be changed at any time.">
        <VBox spacing="12">
            <HBox spacing="8">
                <MenuButton fx:id="dynamicMenuButton" text="Recent files"/>
                <Button text="Add item" onAction="#onAddItem"/>
                <Button text="Clear" onAction="#onClearItems"/>
            </HBox>
            <Label fx:id="dynamicOutput" styleClass="example-output"/>
        </VBox>
    </Example>
</DemoPage>
