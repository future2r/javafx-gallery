<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="name.ulbricht.javafx.gallery.shell.CategoryController"
      styleClass="page, category-page">
    <VBox spacing="6">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <StackPane fx:id="iconHolder"/>
            <Label fx:id="title" styleClass="page-title"/>
        </HBox>
        <Label fx:id="description" wrapText="true" styleClass="page-description"/>
    </VBox>
    <FlowPane fx:id="tiles" hgap="12" vgap="12"/>
</VBox>
